# SmartHostel X — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local development (Docker):  postgresql://smarthostel:smarthostel_secret@localhost:5432/smarthosteldb
# Docker Compose (container):  postgresql://smarthostel:smarthostel_secret@postgres:5432/smarthosteldb
DATABASE_URL="postgresql://smarthostel:smarthostel_secret@localhost:5432/smarthosteldb"

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret. Must be at least 32 characters.
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET="smarthostel-default-development-jwt-secret-key-12345"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Gemini AI (Cloud LLM) ───────────────────────────────────────────────────
# Get a free API key from: https://aistudio.google.com/app/apikey
# The key will look like: AIzaSy... or AQ.Ab8...
GEMINI_API_KEY="your-gemini-api-key-here"

# The Gemini model to use.
# Recommended: gemini-2.5-flash (fast, generous free tier)
# Premium:     gemini-2.5-pro   (higher quality, lower free quota)
GEMINI_MODEL="gemini-2.5-flash"

# ─── AI Setup Notes ──────────────────────────────────────────────────────────
# No local AI server needed. Gemini runs in Google's cloud.
# The app automatically falls back through model variants if one is overloaded.
# Verify AI is working: GET http://localhost:3000/health/ai

# ─── Observability ───────────────────────────────────────────────────────────
# Optional: Token to protect the /metrics Prometheus endpoint.
# If unset, /metrics is publicly accessible (fine for local dev).
# METRICS_TOKEN="your-secure-metrics-token"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
