# SmartHostel X — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local development (Docker):  postgresql://smarthostel:smarthostel_secret@localhost:5432/smarthosteldb
# Docker Compose (container):  postgresql://smarthostel:smarthostel_secret@postgres:5432/smarthosteldb
DATABASE_URL="postgresql://smarthostel:smarthostel_secret@localhost:5432/smarthosteldb"

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret. Must be at least 32 characters.
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET="smarthostel-default-development-jwt-secret-key-12345"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Ollama AI (Local LLM) ───────────────────────────────────────────────────
# Base URL for the Ollama API.
# Local development:   http://localhost:11434  (if running Ollama locally or Docker with -p 11434:11434)
# Docker Compose:      http://ollama:11434     (backend container uses internal network name)
OLLAMA_BASE_URL="http://localhost:11434"

# The LLM model to use. Must be pulled before first AI request.
# Default: qwen2.5:3b (~1.9 GB download, requires ~2.5 GB RAM)
# Alternatives: qwen2.5:7b (~4.7 GB, higher quality), phi4-mini:3.8b (~2.8 GB)
OLLAMA_MODEL="qwen2.5:3b"

# ─── First-Run Model Setup ───────────────────────────────────────────────────
# When using Docker Compose, the Ollama container auto-pulls the model on startup.
# For local development without Docker Compose:
#
#   1. Install Ollama: https://ollama.com/download
#   2. Start Ollama:   ollama serve
#   3. Pull the model: ollama pull qwen2.5:3b
#
# When using Docker manually:
#   docker run -d --name smarthostel-ollama -p 11434:11434 -v ollama_data:/root/.ollama ollama/ollama:latest
#   docker exec smarthostel-ollama ollama pull qwen2.5:3b
#
# Verify Ollama is working:  curl http://localhost:11434/api/tags
# Verify model is loaded:    GET http://localhost:3000/health/ai

# ─── Observability ───────────────────────────────────────────────────────────
# Optional: Token to protect the /metrics Prometheus endpoint.
# If unset, /metrics is publicly accessible (fine for local dev).
# METRICS_TOKEN="your-secure-metrics-token"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
